<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.secondhand.mapper.OrderMapper">
    <resultMap id="OrderVOMap" type="com.campus.secondhand.vo.OrderVO">
        <id property="id" column="id" />
        <result property="orderNo" column="order_no" />
        <result property="buyerId" column="buyer_id" />
        <result property="sellerId" column="seller_id" />
        <result property="totalAmount" column="total_amount" />
        <result property="payAmount" column="pay_amount" />
        <result property="status" column="status" />
        <result property="addressSnapshot" column="address_snapshot" />
        <result property="payTime" column="pay_time" />
        <result property="remark" column="remark" />
        <result property="payMethod" column="pay_method" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="buyerNickname" column="buyer_nickname" />
        <result property="buyerAvatar" column="buyer_avatar" />
        <result property="sellerNickname" column="seller_nickname" />
        <result property="sellerAvatar" column="seller_avatar" />
        <collection property="items"
                     columnPrefix="item_"
                     resultMap="com.campus.secondhand.mapper.OrderItemMapper.OrderItemMap"/>
    </resultMap>

    <sql id="Base_Column_List">
        o.id,o.order_no,o.buyer_id,o.seller_id,o.total_amount,o.pay_amount,
        o.status,o.address_snapshot,o.pay_time,o.remark,o.pay_method,
        o.create_time,o.update_time
    </sql>

    <!--分页查询订单id-->
    <select id="selectOrderIdsByPage" resultType="java.lang.Long">
        select o.id from `order` o
        <where>
            <if test="query != null and query.status != null and query.status != 'all'">
                and o.status = #{query.status}
            </if>
            <if test="query != null and query.role != null and query.role == 'buyer'">
                and o.buyer_id = #{userId}
            </if>
            <if test="query != null and query.role != null and query.role == 'seller'">
                and o.seller_id = #{userId}
            </if>
        </where>
    </select>

    <!--通过订单id查询订单列表及每个订单的详情-->
    <select id="selectOrderListByOrderIds" resultMap="OrderVOMap">
        select
            <include refid="Base_Column_List"/>,
            t1.nickname as buyer_nickname,
            t1.avatar as buyer_avatar,
            t2.nickname as seller_nickname,
            t2.avatar as seller_avatar,
            oi.id as item_id,
            oi.product_id as item_product_id,
            oi.product_title as item_product_title,
            oi.product_cover as item_product_cover,
            oi.price as item_price,
            oi.quantity as item_quantity,
            oi.total_amount as item_total_amount
        from `order` o
        left join (select id, nickname, avatar from `user`) t1
        on o.buyer_id = t1.id
        left join (select id, nickname, avatar from `user`) t2
        on o.seller_id = t2.id
        left join order_item oi on o.id = oi.order_id
        where o.id in
        <foreach collection="orderIds" item="id" open="(" separator="," close=")">
        #{id}
        </foreach>
        order by o.create_time desc
    </select>
</mapper>