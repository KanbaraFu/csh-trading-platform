<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.secondhand.mapper.CategoryMapper">

    <resultMap id="BaseResultMap" type="com.campus.secondhand.pojo.Category">
            <id property="id" column="id" />
            <result property="name" column="name" />
            <result property="sort" column="sort" />
            <result property="status" column="status" />
            <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="Base_Column_List">
        id,name,sort,status,create_time
    </sql>
    <select id="selectCategoryById" resultType="com.campus.secondhand.pojo.Category">
        select <include refid="Base_Column_List"/>
        from category
        where id=#{categoryId}
    </select>
</mapper>
