<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.secondhand.mapper.MessageMapper">

    <resultMap id="BaseResultMap" type="com.campus.secondhand.pojo.Message">
            <id property="id" column="id" />
            <result property="userId" column="user_id" />
            <result property="type" column="type" />
            <result property="title" column="title" />
            <result property="content" column="content" />
            <result property="bizId" column="biz_id" />
            <result property="isRead" column="is_read" />
            <result property="createTime" column="create_time" />
    </resultMap>

    <!-- 评论VO结果映射 -->
    <resultMap id="MessageVoResultMap" type="com.campus.secondhand.vo.MessageVo">
        <id property="id" column="id" />
        <result property="type" column="type" />
        <result property="title" column="title" />
        <result property="content" column="content" />
        <result property="bizId" column="biz_id" />
        <result property="isRead" column="is_read" />
        <result property="createTime" column="create_time" />
        <result property="productId" column="product_id" />
        <result property="productCover" column="product_cover" />
        <result property="productTitle" column="product_title" />
    </resultMap>

    <sql id="Base_Column_List">
        id,user_id,type,title,content,biz_id,
        is_read,create_time
    </sql>

<!--    更新单条信息-->
    <update id="updateReadStatus">
        UPDATE message
        SET is_read = 1
        WHERE id = #{id} AND user_id = #{userId} AND is_read = 0
    </update>

<!--    更新所有数据为已读-->
    <update id="updateAllReadStatus">
        UPDATE message
        SET is_read = 1
        WHERE user_id = #{userId} AND is_read = 0
        <if test="type != null and type != ''">
            AND type = #{type}
        </if>
    </update>

    <!-- 查询消息总数（可按类型筛选） -->
    <select id="countMessages" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM message
        WHERE user_id = #{userId}
        <if test="type != null and type != ''">
            AND type = #{type}
        </if>
    </select>

    <!--    分页条件查询消息-->
    <select id="selectMessages" resultMap="MessageVoResultMap">
        SELECT m.id, m.type, m.title, m.content, m.biz_id, m.is_read, m.create_time,
        p.id AS product_id, p.cover AS product_cover, p.title AS product_title
        FROM message m
        LEFT JOIN product p ON m.biz_id = p.id AND m.type = 'comment'
        WHERE m.user_id = #{userId}
        <if test="type != null and type != ''">
            AND m.type = #{type}
        </if>
        ORDER BY m.create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- 查询未读消息数量 -->
    <select id="countUnread" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM message
        WHERE user_id = #{userId} AND is_read = 0
    </select>
</mapper>
